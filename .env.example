# Server Port (Render automatically sets this to 10000 in production)
PORT=5000

# Environment mode
NODE_ENV=production

# MongoDB Atlas Connection URI (Production replica set cluster)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/exam_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/exam_tracker?retryWrites=true&w=majority

# JWT secret key for signing user sessions
JWT_SECRET=your_super_secret_jwt_key_2026

# Frontend Vercel URL for CORS and cohort links
CLIENT_URL=https://your-frontend.vercel.app
